# Server configuration

# MongoDB Atlas connection string (rotate credentials before reuse — never commit real values)
MONGO_URI=

# Server port
PORT=

# Environment mode (development / production)
NODE_ENV=

# Auth
JWT_SECRET=
PRIVATE_KEY=
PUBLIC_KEY=

# OpenAI API key (used for toxicity detection / content generation)
OPENAI_API_KEY=

# Admin/site URLs
localAdminUrl=
LOCALADMINURL=
nodeSiteUrl=
NODESITEURL=

# Comma-separated list of user IDs used by the app
USER_IDS=

# Generic account/user handle
handle=

# News outlet identifiers/keys (used in server routes — likely per-outlet API keys or account handles)
DerSpeigel=
faznet=
zeit=
Tagesspeigel=
DnevniInformer=
NarodneNovosti=
SrbskiGlas=
Netflix=
SkySport=

# Bot/persona identifiers
Eule=
Gans=
Giraffe=
Katze=
Kuh=
Schafe=
